/*
 * CnT-processing: CUT&Tag FASTQ -> normalized bigWigs, counts, SEACR peaks, QC.
 *
 * Every parameter below can be set on the command line (`--name value`) or in a
 * params.json file (`-params-file params.json`).
 */

manifest {
    name            = 'CnT-processing'
    description     = 'Simple CUT&Tag pipeline: FASTQ to normalized bigWigs, counts, SEACR peaks and QC'
    author          = 'Jacob Greene'
    homePage        = 'https://github.com/jacob-greene/CnT-processing'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0dev'
}

params {
    // ---- Required inputs ----
    samplesheet   = null          // CSV: sample,fastq_1,fastq_2,control,is_control,pool
    genome        = null          // hg38 | hg19 | mm10 | dm6
    outdir        = 'results'

    // ---- Reference overrides (default: the entry for `genome` in conf/genomes.config) ----
    chrom_sizes     = null
    mito_contig     = null
    gtf             = null
    gtf_chrom_map   = null
    fasta           = null      // genome FASTA(s); used to build a Bowtie2 index when bowtie2_index = false
    ccre_bed        = null
    blacklist       = null
    bowtie2_index   = null
    // E. coli K-12 MG1655 (ENA U00096.3), shipped gzipped in assets/ so no run
    // depends on ENA. md5 of the uncompressed FASTA: 805d1558950b76c15883a718da46d3e1.
    // The Bowtie2 index is built from this FASTA unless `ecoli_index` is set.
    ecoli_fasta   = "${projectDir}/assets/U00096.3.fa.gz"
    ecoli_index   = null

    // ---- Options ----
    keep_chrM              = true    // keep the mitochondrial contig in fragments and genome_size
    min_mapq               = 10
    promoter_window        = 5000    // promoters = protein-coding TSS +/- this many bp
    plot_window            = 5000    // +/- bp around TSSs and peak summits in deepTools plots
    optical_pixel_distance = 2500    // 2500 for patterned flow cells (NovaSeq, HiSeq X/4000); 100 for unpatterned
    readcount_scaled_bw    = false
    dedup_controls         = false
    blacklist_filter       = false
    validate_only          = false   // check the sample sheet and genome settings, then stop

    // ---- Resource caps (each process request is clipped to these) ----
    max_cpus   = 16
    max_memory = '120.GB'
    max_time   = '24.h'

    // ---- Containers (pinned biocontainers) ----
    container__bedtools   = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_2'
    container__fastqc     = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    container__trimgalore = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_1'
    // bowtie2 2.5.2 + samtools 1.18 + pigz (the nf-core bowtie2 image)
    container__bowtie2    = 'quay.io/biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d750af9c83b4d45a:f70b31a2db15c023d641c32f433fb02cd04df5a6-0'
    container__samtools   = 'quay.io/biocontainers/samtools:1.21--h96c455f_1'
    container__picard     = 'quay.io/biocontainers/picard:3.3.0--hdfd78af_0'
    container__ucsc       = 'quay.io/biocontainers/ucsc-bedgraphtobigwig:472--h9b8f530_1'
    // Python 3 with numpy, matplotlib and pyBigWig (used for tables and plots)
    container__python     = 'quay.io/biocontainers/deeptools:3.5.6--pyhdfd78af_0'
}

includeConfig 'conf/genomes.config'
includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Fred Hutch gizmo cluster. Set `--scratch_dir` (or SCRATCH_DIR) to a folder on scratch.
    slurm {
        includeConfig 'conf/slurm.config'
    }
    // Fred Hutch Lmod modules instead of containers (no Docker/Apptainer needed).
    // Combine with slurm or run locally, e.g. -profile test,modules
    modules {
        includeConfig 'conf/modules.config'
    }
    // Small chr22 + chrM data set, built by tests/make_test_data.sh. Combine with docker, singularity or modules.
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
