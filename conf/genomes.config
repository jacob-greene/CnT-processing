/*
 * Reference files for each supported genome.
 *
 * Select a genome with `--genome hg38|hg19|mm10|dm6`. Every key below can be
 * overridden on the command line or in params.json, e.g. `--gtf /my/genes.gtf`.
 * Remote URLs are downloaded by Nextflow into the work directory on first use.
 *
 * chrom_sizes   UCSC <genome>.chrom.sizes. The pipeline keeps only canonical
 *               chromosomes: every name that contains "_" is dropped
 *               (_random, chrUn_*, _alt, _fix, _hap). The mitochondrial contig
 *               is kept or dropped by `params.keep_chrM`.
 * genome_size   NOT stored here. It is computed at run time as the sum of the
 *               canonical chromosome sizes (minus merged blacklist bp when
 *               `blacklist_filter = true`). See bin/genome_size.sh.
 * mito_contig   Mitochondrial contig name, used for the % chrM column.
 * gtf           Gene annotation with UCSC-style chromosome names.
 * gtf_chrom_map Optional two-column TSV (GTF name -> UCSC name). When set, GTF
 *               chromosome names are translated and unlisted contigs are dropped.
 *               Used for dm6, whose Ensembl GTF uses "2L", "mitochondrion_genome", ...
 * ccre_bed      ENCODE SCREEN cCREs (all classes). null = cCRE counting skipped.
 * blacklist     ENCODE blacklist v2 (Amemiya et al. 2019), Boyle-Lab GitHub,
 *               pinned to commit 61a04d2c5e49341d76735d485c61f0d1177d08a8.
 *               Used only when `blacklist_filter = true`.
 * bowtie2_index Bowtie2 index prefix. The defaults are the shared Fred Hutch
 *               iGenomes (UCSC) indexes. Outside Fred Hutch, pass your own
 *               `--bowtie2_index` (see docs/inputs.md, "Supported genomes").
 *
 * md5 checksums (of the downloaded file) are recorded for each URL so a
 * changed upstream file can be detected.
 */

params {
    genomes {
        'hg38' {
            // md5 c42e9f75fff906c6a7143cb2fac86602 (455 lines, Last-Modified 2013-12-25)
            chrom_sizes     = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.chrom.sizes'
            mito_contig     = 'chrM'
            // GENCODE release 50 (Ensembl 116, released 2026-06-09), comprehensive, reference
            // chromosomes only. md5 2d273848c6068682fabea72fae4896a9 (matches GENCODE MD5SUMS)
            gtf             = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.annotation.gtf.gz'
            gtf_chrom_map   = null
            // ENCODE v4 agnostic cCREs, ENCSR800VNX / ENCFF420VPZ, md5 ea1820bd71581ba01c94fc600fbf794d
            ccre_bed        = 'https://www.encodeproject.org/files/ENCFF420VPZ/@@download/ENCFF420VPZ.bed.gz'
            // md5 83fe6bf8187a64dee8079b80f75ba289
            blacklist       = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/61a04d2c5e49341d76735d485c61f0d1177d08a8/lists/hg38-blacklist.v2.bed.gz'
            bowtie2_index   = '/shared/biodata/reference/iGenomes/Homo_sapiens/UCSC/hg38/Sequence/Bowtie2Index/genome'
        }
        'hg19' {
            // md5 b3b0fcf79b5477ab0b3af02e81eac8dc (93 lines)
            chrom_sizes     = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.chrom.sizes'
            mito_contig     = 'chrM'
            // GENCODE release 19 (Ensembl 74), the last native GRCh37 release.
            // md5 bd83e28270e595d3bde6bfcb21c9748f
            gtf             = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_19/gencode.v19.annotation.gtf.gz'
            gtf_chrom_map   = null
            // ENCODE v1 "candidate regulatory regions for hg19", ENCSR911QEI / ENCFF788SJC,
            // md5 1a972fc5f5cc7d31e0ddeda7a7b1ac26. ENCODE has no v3/v4 hg19 cCRE release.
            ccre_bed        = 'https://www.encodeproject.org/files/ENCFF788SJC/@@download/ENCFF788SJC.bed.gz'
            // md5 24b982fd681020b1cf030b18a2f0f586
            blacklist       = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/61a04d2c5e49341d76735d485c61f0d1177d08a8/lists/hg19-blacklist.v2.bed.gz'
            bowtie2_index   = '/shared/biodata/reference/iGenomes/Homo_sapiens/UCSC/hg19/Sequence/Bowtie2Index/genome'
        }
        'mm10' {
            // md5 5a103c9a15dd660c295a089ef5035672 (66 lines)
            chrom_sizes     = 'https://hgdownload.soe.ucsc.edu/goldenPath/mm10/bigZips/mm10.chrom.sizes'
            mito_contig     = 'chrM'
            // GENCODE mouse release M25 (Ensembl 100), the last GRCm38 release.
            // md5 0c38fc4ccbc731a2708fc91e7f1c2efd
            gtf             = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M25/gencode.vM25.annotation.gtf.gz'
            gtf_chrom_map   = null
            // ENCODE v4 agnostic cCREs, ENCSR412JPD / ENCFF167FJQ, md5 e054b7a2a0c572d060ccb851b7a294fc
            ccre_bed        = 'https://www.encodeproject.org/files/ENCFF167FJQ/@@download/ENCFF167FJQ.bed.gz'
            // md5 4ae47e40309533c2a71de55494cda9bc
            blacklist       = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/61a04d2c5e49341d76735d485c61f0d1177d08a8/lists/mm10-blacklist.v2.bed.gz'
            bowtie2_index   = '/shared/biodata/reference/iGenomes/Mus_musculus/UCSC/mm10/Sequence/Bowtie2Index/genome'
        }
        'dm6' {
            // md5 a5d9388d72adfc0cdf74e533206f51c2 (1870 lines)
            chrom_sizes     = 'https://hgdownload.soe.ucsc.edu/goldenPath/dm6/bigZips/dm6.chrom.sizes'
            mito_contig     = 'chrM'
            // Ensembl release 116, BDGP6.54 (FlyBase annotation on the Release 6 assembly,
            // GCA_000001215.4 = UCSC dm6). Ensembl CHECKSUMS (sum): 10582 6962,
            // md5 4aaa5a1bb9d44253d93d23398c2b8afb.
            // Chromosome names are translated to UCSC names with gtf_chrom_map.
            gtf             = 'https://ftp.ensembl.org/pub/release-116/gtf/drosophila_melanogaster/Drosophila_melanogaster.BDGP6.54.63.gtf.gz'
            gtf_chrom_map   = "${projectDir}/assets/dm6_ensembl_to_ucsc.tsv"
            // ENCODE publishes no cCREs for dm6: cCRE counting is skipped with a log message.
            ccre_bed        = null
            // md5 f5b300bb738624499161276a5e36d130
            blacklist       = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/61a04d2c5e49341d76735d485c61f0d1177d08a8/lists/dm6-blacklist.v2.bed.gz'
            bowtie2_index   = '/shared/biodata/reference/iGenomes/Drosophila_melanogaster/UCSC/dm6/Sequence/Bowtie2Index/genome'
        }
    }
}
