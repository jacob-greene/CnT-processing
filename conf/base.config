/*
 * Default resources per process label.
 *
 * Out-of-memory exits (137 = killed, 140 = Slurm limit, 143 = terminated) are
 * retried up to twice. Each retry multiplies memory (and time) by the attempt.
 * Requests are capped by params.max_cpus / max_memory / max_time.
 */

process {
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration
    ]

    cpus   = 1
    memory = { 2.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
