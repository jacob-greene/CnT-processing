/*
 * Test profile: three K562 samples (Kaya-Okur et al. 2020, GEO GSE145187),
 * restricted to read pairs that align to chr22 or chrM (plus E. coli carry-over
 * pairs), at three different depths. Built by tests/make_test_data.sh.
 *
 *   nextflow run jacob-greene/CnT-processing -profile test,docker
 *
 * genome_size is computed from the chr22 + chrM chrom sizes, so the
 * coverage-normalized bigWigs average ~1 over the test contigs.
 */

params {
    samplesheet         = "${projectDir}/tests/data/samplesheet.csv"
    genome              = 'hg38'
    chrom_sizes         = "${projectDir}/tests/data/genome/chr22_chrM.chrom.sizes"
    gtf                 = "${projectDir}/tests/data/genome/chr22_chrM.gencode.v50.gtf.gz"
    ccre_bed            = "${projectDir}/tests/data/genome/chr22_chrM.ccre.bed.gz"
    blacklist           = "${projectDir}/tests/data/genome/chr22_chrM.blacklist.v2.bed.gz"
    // The chr22 + chrM Bowtie2 index is built by the pipeline from this FASTA.
    fasta               = [
        'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/chromosomes/chr22.fa.gz',
        'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/chromosomes/chrM.fa.gz'
    ]
    bowtie2_index       = false   // false = build the index from `fasta`
    readcount_scaled_bw = true
    blacklist_filter    = false

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'
}

// base.config read params.max_* before this profile set them, so cap here too.
process.resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
