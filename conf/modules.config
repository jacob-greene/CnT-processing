/*
 * Fred Hutch Lmod modules instead of containers.
 *
 *   nextflow run jacob-greene/CnT-processing -profile modules ...         (local)
 *   nextflow run jacob-greene/CnT-processing -profile slurm,modules ...   (gizmo jobs)
 *
 * Put `modules` AFTER `slurm`, so it switches off Singularity. Module versions
 * are close to, but not always the same as, the pinned container versions;
 * software_versions.yml records what actually ran. Each process loads only the
 * modules it needs, so toolchains never mix inside one job.
 */

singularity.enabled = false
docker.enabled      = false

process {
    container = null

    withName: 'GENOME_SIZE|PREPARE_GTF|FRAGMENTS.*|PEAK_STATS' {
        module = 'BEDTools/2.31.0-GCC-12.3.0'
    }
    withName: 'BOWTIE2_.*' {
        module = 'Bowtie2/2.5.4-GCC-13.2.0:SAMtools/1.19.2-GCC-13.2.0'
    }
    withName: 'CAT_FASTQ|FILTER_BAM|NAMESORT' {
        module = 'SAMtools/1.21-GCC-13.3.0'
    }
    withName: 'FASTQC' {
        module = 'FastQC/0.12.1-Java-11'
    }
    withName: 'TRIM_GALORE' {
        module = 'Trim_Galore/0.6.7-GCCcore-11.2.0'
    }
    withName: 'MARKDUPLICATES' {
        module = 'picard/2.25.1-Java-11'
    }
    withName: 'BIGWIG.*' {
        module = 'Kent_tools/468-GCC-12.3.0'
    }
    withName: 'SCALE_FACTORS|QC_TABLES|FRAGMENT_SIZE_PLOT|SOFTWARE_VERSIONS|ANNOTATIONS' {
        module = 'matplotlib/3.8.2-gfbf-2023b'
    }
    withName: 'FEATURECOUNTS' {
        module = 'Subread/2.0.3-GCC-11.2.0'
    }
    // SEACR has no module: the process fetches the pinned SEACR v1.3 scripts from GitHub.
    withName: 'SEACR' {
        module = 'R/4.3.2-gfbf-2023a:BEDTools/2.31.0-GCC-12.3.0'
    }
    withName: 'DEEPTOOLS_.*|CORRELATION' {
        module = 'deepTools/3.5.4.post1-gfbf-2022b'
    }
    withName: 'MULTIQC' {
        module = 'MultiQC/1.21-foss-2023a'
    }
}
