/*
 * Fred Hutch gizmo cluster (Slurm + Singularity/Apptainer).
 *
 *   nextflow run jacob-greene/CnT-processing -profile slurm \
 *       --scratch_dir /fh/scratch/delete90/<lab>/<user>/nextflow/ ...
 *
 * scratch_dir holds the Nextflow work directory and the container cache.
 * It can also be set with the SCRATCH_DIR environment variable.
 */

params.scratch_dir = System.getenv('SCRATCH_DIR') ?: null
params.queue       = System.getenv('QUEUE') ?: 'campus-new'

if (params.scratch_dir) {
    workDir = "${params.scratch_dir.toString().replaceAll('/+$', '')}/work"
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = params.scratch_dir ? "${params.scratch_dir.toString().replaceAll('/+$', '')}/cache" : null
    runOptions = '--containall --no-home --bind /tmp'
}
docker.enabled = false

executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10/1sec'
}

process {
    executor = 'slurm'
    queue    = params.queue
}
